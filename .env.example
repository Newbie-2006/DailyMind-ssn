# The Android app needs the public HTTPS URL where the Gary server is deployed.
VITE_GARY_API_URL=https://your-secure-gary-service.example

# Set this on the server only. Never add it to this file or the Android app.
# GEMINI_API_KEY=your_gemini_key

# Optional server-side fallback when Gemini is temporarily unavailable.
# GROQ_API_KEY=your_groq_key
# GROQ_MODEL=llama-3.3-70b-versatile
